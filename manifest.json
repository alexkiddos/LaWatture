{
  "name": "LaWatture",
  "short_name": "LaWatture",
  "description": "Préparez un itinéraire avec GeoRouter et suivez-le en direct avec Roadbook VE.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f8fafc",
  "theme_color": "#0284c7",
  "orientation": "portrait-primary",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "./roadbook.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "trace", "accept": [".gpx", ".json", ".geojson", "application/gpx+xml", "application/json"] }
      ]
    }
  }
}
